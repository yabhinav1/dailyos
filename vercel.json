{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npx prisma migrate deploy; fi && npm run build",
  "crons": [
    {
      "path": "/api/cron/purge-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "30 2 * * *"
    }
  ]
}
