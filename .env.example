# Copy to .env.local for local development. Real values live in the Vercel
# project settings — never commit a filled-in copy of this file.

# --- Database -----------------------------------------------------------
# Postgres (Neon). Keep sslmode=verify-full: pg v9 will reinterpret a bare
# `require` with weaker guarantees, and Neon presents a publicly trusted cert.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full&channel_binding=require"

# Same database on Neon's DIRECT endpoint — the host without "-pooler".
# Only migrations use it; the pooled URL above cannot take advisory locks.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# MongoDB, used for project file/attachment storage.
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net/dailyos"

# --- Auth ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth app. Callback URL must be
# <NEXT_PUBLIC_APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth app (Google Cloud Console > Credentials > OAuth client ID).
# Authorised redirect URI must be
# <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public origin of the deployment; used in emails and OAuth callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Transactional email (ZeptoMail) ------------------------------------
SMTP_HOST="smtp.zeptomail.in"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DailyOS <noreply@example.com>"

# --- Scheduled jobs -----------------------------------------------------
# Shared secret for /api/cron/purge-accounts, which deletes accounts whose
# 24-hour deletion grace period has expired. Vercel sends this automatically
# as `Authorization: Bearer $CRON_SECRET`. Unset, the route refuses to run.
# openssl rand -hex 32
CRON_SECRET=""

# --- Music --------------------------------------------------------------
# Spotify app credentials — search/metadata only, no playback.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Stream resolver service backing /api/music/external-stream.
RESOLVER_URL=""
RESOLVER_API_KEY=""

# --- AI (optional) ------------------------------------------------------
# Enables real AI summaries, translation and "Turn into Tasks" in notes.
# Without it, summaries and task extraction fall back to local rules and
# translation is unavailable. Only signed-in users can trigger calls.
OPENAI_API_KEY=""

# --- Error alerts (optional) --------------------------------------------
# Every server error is logged as one JSON line regardless. Set this to a
# Discord or Slack incoming-webhook URL to also be pinged (deduplicated).
ERROR_WEBHOOK_URL=""

# --- Push notifications (optional) -------------------------------------
# Morning reminders as phone/desktop notifications. Generate a pair with
# `npx web-push generate-vapid-keys`. Changing them signs everyone out of push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Hourly reminder scheduler (optional) ------------------------------
# Secret for .github/workflows/reminders.yml, which calls the reminders
# endpoint hourly so each person gets theirs at 8am local time. Set the same
# value as a GitHub repository secret named SCHEDULER_SECRET.
SCHEDULER_SECRET=""
